{
  "name": "signal-ghost",
  "productName": "SIGNAL GHOST",
  "version": "0.1.0",
  "description": "SCYTHE: GAME desktop prototype. A self-contained, offline intelligence-analysis game.",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "stage": "node scripts/stage.js",
    "start": "node scripts/stage.js && electron .stage --user-data-dir=.stage-profile",
    "package:linux": "node scripts/package.js linux",
    "package:win": "node scripts/package.js win32",
    "smoke": "node scripts/smoke-run.js"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.1.0"
  }
}
