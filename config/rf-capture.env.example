# SCYTHE RF capture parameters -- example. Copy to ~/.config/scythe/rf-capture.env
# and edit the receiver serial. Contains no secrets and none should be added:
# both consuming units are readable by the owning user, and this file is
# committed to the repository as a template.
#
# WHY ONE FILE
#
# rf_bridge sends rtl_tcp only SET_GAIN_MODE (0x03) and SET_GAIN (0x04). There
# is no SET_SAMPLE_RATE opcode, so the rate rtl_tcp was launched with via -s is
# the rate the hardware runs, and SDRPP_SAMPLE_RATE_HZ is only what the bridge
# claims. The claim drives bin_width = sample_rate_hz / fft_size and the
# min/max frequency axis. A mismatch mislabels every frequency in the trace and
# raises nothing. scythe-rtl-tcp.service and scythe-orchestrator.service
# therefore read these values from this one file.

SDRPP_IQ_HOST=127.0.0.1
SDRPP_IQ_PORT=1234

# 2.048 MS/s is the configured rate. It is deliberately not the tuner's 2.4 MHz
# nominal capability, and it is not a measurement: see the
# capture_rate_declaration block in the bridge status, which publishes this as
# SHARED_LAUNCH_CONFIGURATION with runtime_attestation UNAVAILABLE.
SDRPP_SAMPLE_RATE_HZ=2048000
SDRPP_CENTER_FREQUENCY_HZ=100000000

# Receiver serial, passed to rtl_tcp as -d.
#
# This is CONFIGURATION AUTHORITY, not USB attestation. It selects which
# receiver rtl_tcp opens; it does not prove which receiver is physically
# connected, which antenna is on it, or that the device answering to this
# serial is the one the operator believes it to be. Device index 0 is avoided
# on purpose: index is whichever SDR enumerates first, which need not be the
# receiver named in SDRPP_SENSOR_ID.
SCYTHE_RTL_DEVICE_SERIAL=00000001
