{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scythe.local/schemas/graphops-directive-request-v1.schema.json",
  "title": "GraphOps Directive Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "directiveId", "directive", "selection", "requestedMode", "idempotencyKey"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "directiveId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "directive": {"enum": ["explain.coverage-cell", "reclassify.coverage-threshold"]},
    "utterance": {"type": "string", "maxLength": 2000},
    "selection": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "datasetId", "tileId", "longitudeDegrees", "latitudeDegrees"],
        "properties": {
          "kind": {"const": "rf-cell"},
          "datasetId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "tileId": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
          "longitudeDegrees": {"type": "number", "minimum": -180, "maximum": 180},
          "latitudeDegrees": {"type": "number", "minimum": -90, "maximum": 90},
          "displayValue": {"type": "number"},
          "displayUnits": {"type": "string", "maxLength": 32},
          "displayAssetHash": {"type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$"},
          "coverageThreshold": {
            "type": "object", "additionalProperties": false,
            "required": ["value", "units", "comparison"],
            "properties": {
              "value": {"type": "number"}, "units": {"type": "string"},
              "comparison": {"enum": ["LTE", "GTE"]}
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "threshold": {"type": "number"}, "units": {"type": "string"},
        "comparison": {"enum": ["LTE", "GTE"]}
      }
    },
    "viewContext": {"type": "object"},
    "requestedMode": {"enum": ["preview", "execute"]},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
