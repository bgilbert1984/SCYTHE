{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scythe.local/schemas/graphops-directive-request-v1.schema.json",
  "title": "GraphOps Directive Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "directiveId", "directive", "selection", "requestedMode", "idempotencyKey"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "directiveId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "directive": {"enum": ["explain.coverage-cell", "reclassify.coverage-threshold", "correlate.rf-cell-graph", "compare.graph-delta", "trace.provenance-impact", "expose.contradictions", "compare.causal-worlds", "explain.lunar-location"]},
    "utterance": {"type": "string", "maxLength": 2000},
    "selection": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind"],
        "properties": {
          "kind": {"enum": ["rf-cell", "lunar-location", "graph-node", "graph-edge", "event", "time-pin"]},
          "datasetId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
          "tileId": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,256}$"},
          "longitudeDegrees": {"type": "number", "minimum": -180, "maximum": 180},
          "latitudeDegrees": {"type": "number", "minimum": -90, "maximum": 90},
          "displayValue": {"type": "number"},
          "displayUnits": {"type": "string", "maxLength": 32},
          "displayAssetHash": {"type": "string", "pattern": "^(sha256:)?[a-f0-9]{64}$"},
          "entityId": {"type": "string", "minLength": 1, "maxLength": 512},
          "graphRevision": {"type": "string", "minLength": 1, "maxLength": 128},
          "position": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "number"}},
          "observedAt": {"type": ["number", "string", "null"]},
          "timestamp": {"type": "number"},
          "clockId": {"type": "string", "minLength": 1, "maxLength": 128},
          "uncertaintyMilliseconds": {"type": "number", "minimum": 0},
          "locationId": {"type": "string", "minLength": 1, "maxLength": 256},
          "celestialBody": {"const": "MOON"},
          "referenceFrame": {"const": "MOON_ME_DE421"},
          "heightMeters": {"type": "number"},
          "spatialAuthority": {"const": "REFERENCE_ELLIPSOID_ONLY"},
          "coverageThreshold": {
            "type": "object", "additionalProperties": false,
            "required": ["value", "units", "comparison"],
            "properties": {
              "value": {"type": "number"}, "units": {"type": "string"},
              "comparison": {"enum": ["LTE", "GTE"]}
            }
          }
        }
      }
    },
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "threshold": {"type": "number"}, "units": {"type": "string"},
        "comparison": {"enum": ["LTE", "GTE"]},
        "depth": {"type": "integer", "minimum": 0, "maximum": 5},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "viewContext": {"type": "object"},
    "requestedMode": {"enum": ["preview", "execute"]},
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
