{
  "variables": {
    "defaultTenantId": "#{DEFAULT_TENANT_ID()}",
    "smtpPassword": "#{PROMPT_HIDDEN('Gandi mailbox password')}"
  },
  "requests": [
    {
      "method": "PATCH",
      "url": "/api/tenant/#{defaultTenantId}",
      "body": {
