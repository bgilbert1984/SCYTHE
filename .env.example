# ─── RF SCYTHE / NerfEngine — Environment Configuration ─────────────────────
# Copy to .env and adjust for your deployment.
#
#   cp .env.example .env

# ── Orchestrator ──────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=5001
STREAM_RELAY_PORT=8765
MCP_WS_PORT=8766
# Standalone /mcp authentication. The integrated Flask server also accepts its
# existing operator session or INTERNAL_TOKEN credentials.
MCP_INTERNAL_TOKEN=
# Keep false for AI clients. An operator may temporarily enable this to perform
# an explicit autonomy-phase transition through MCP.
MCP_ALLOW_REMOTE_PHASE_CONTROL=false

# Stream relay URL seen by the browser UI and Android client.
# Must be reachable from the device running the browser (not internal Docker IP).
# Example for a local LAN server at 192.168.1.185:
STREAM_RELAY_URL=ws://192.168.1.185:8765/ws
MCP_WS_URL=ws://192.168.1.185:8766/ws

# TAK-ML integration (optional)
TAKML_URL=http://localhost:8234

# ── SDR++ edge bridge (optional) ────────────────────────────────────────────
# Configure SDR++ IQ Exporter as TCP Server, Int16, localhost:1234. The sample
# rate and sample type here must exactly match the IQ Exporter module settings.
# Configure SDR++ Rigctl Server to listen on localhost:4532 for tune/mode control.
SDRPP_IQ_HOST=127.0.0.1
SDRPP_IQ_PORT=1234
SDRPP_RIGCTL_HOST=127.0.0.1
SDRPP_RIGCTL_PORT=4532
SDRPP_SAMPLE_TYPE=int16
SDRPP_SAMPLE_RATE_HZ=2048000
SDRPP_CENTER_FREQUENCY_HZ=100000000
SDRPP_FFT_SIZE=4096
SDRPP_MAX_BINS=512
SDRPP_FPS=10
SDRPP_SENSOR_ID=SDRPP-EDGE-01
SDRPP_AUTO_START=false
# Orchestrator owns the IQ/Rigctl sockets. Child instances inherit
# SDRPP_AUTO_START=false and proxy sparse/peak reads back to the broker.
SCYTHE_RF_CAPTURE_OWNER=orchestrator
SDRPP_OBSERVATION_MAX=2048
SDRPP_DETECTION_SNR_DB=12
SDRPP_DETECTION_COOLDOWN_S=1
SDRPP_DETECTION_BUCKET_HZ=5000
# Sparse residual analysis (M0/M1). Does not alter rf-observations schema.
SDRPP_SPARSE_ENABLED=true
SDRPP_SPARSE_WINDOW_S=4
SDRPP_SPARSE_MAX_FRAMES=40
SDRPP_SPARSE_MIN_FRAMES=8
SDRPP_SPARSE_COMPRESSION=1
SDRPP_SPARSE_SEED=20260827
SDRPP_SPARSE_MAX_SUPPORT=3
SDRPP_SPARSE_MAX_CANDIDATES=4
SDRPP_SPARSE_MAD_K=4
SDRPP_SPARSE_MAX_RECORDS=256
SDRPP_SPARSE_MIN_REDUCTION=0.35
SDRPP_SPARSE_MIN_SNR_DB=6
SDRPP_SPARSE_MIN_PERSISTENCE=0.35
SDRPP_TUNER_PPM=0
SDRPP_GAIN_DB=nan
SDRPP_ANTENNA_ID=unspecified
SDRPP_CLOCK_QUALITY=unknown

# External live-data feeds (optional)
AISSTREAM_API_KEY=
N2YO_API_KEY=
CESIUM_ION_TOKEN=
STADIA_API_KEY=

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_PORT=11434

# Linux + host networking: localhost works because containers share network stack.
# macOS / Windows + bridge: use http://ollama:11434 (service name on scythe-net).
OLLAMA_URL=http://localhost:11434
